# Conexão MySQL — ajuste usuário, senha, host e nome do banco
DATABASE_URL="mysql://usuario:senha@localhost:3306/sol_e_lua"

# Porta da API HTTP + WebSocket
PORT=4000

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório e forte em produção
JWT_SECRET="troque-este-valor-em-producao"

# Origem(ns) permitida(s) para CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
