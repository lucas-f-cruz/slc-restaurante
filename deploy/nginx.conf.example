# Exemplo de configuração Nginx — ajuste os caminhos e os domínios antes de usar.
# Abordagem recomendada: dois subdomínios (mais simples, sem precisar configurar
# "base path" no Vite). Coloque em /etc/nginx/sites-available/sol-e-lua e crie o
# link simbólico em sites-enabled.

# ---------- Cardápio do cliente ----------
server {
    listen 80;
    server_name cardapio.soleluacafe.com.br;

    root /var/www/sol-e-lua/apps/client/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}

# ---------- Dashboard administrativo ----------
server {
    listen 80;
    server_name painel.soleluacafe.com.br;

    root /var/www/sol-e-lua/apps/dashboard/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}

# Depois de apontar os dois subdomínios (registros DNS tipo A) para o IP da VPS,
# gere os certificados HTTPS com:
#   sudo certbot --nginx -d cardapio.soleluacafe.com.br -d painel.soleluacafe.com.br
